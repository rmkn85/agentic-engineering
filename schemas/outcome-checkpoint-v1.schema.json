{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome-checkpoint/v1",
  "title": "Collected task source and evidence manifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "outcome-checkpoint/v1"
    },
    "task": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "authorityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "task",
    "authorityDigest",
    "files"
  ],
  "additionalProperties": false
}
