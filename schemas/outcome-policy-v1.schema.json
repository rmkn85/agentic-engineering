{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome-policy/v1",
  "title": "Native frontier required-control policy",
  "type": "object",
  "required": [
    "schema",
    "requiredTasks"
  ],
  "properties": {
    "schema": {
      "const": "outcome-policy/v1"
    },
    "requiredTasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    }
  },
  "additionalProperties": false
}
