#!/usr/bin/env bash
set -uo pipefail

TAIL_LINES="${QUIET_RUN_TAIL_LINES:-80}"
LOG_DIR="${QUIET_RUN_LOG_DIR:-.agent-cache/logs}"
INLINE_FAILURE="${QUIET_RUN_INLINE_FAILURE:-0}"

if [[ "${1:-}" == "--" ]]; then shift; fi
if [[ $# -eq 0 ]]; then
  echo "usage: quiet-run -- command [args...]" >&2
  exit 64
fi

mkdir -p "$LOG_DIR"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
base="$(printf '%s' "$(basename "$1")" | tr -cs 'A-Za-z0-9._-' '_')"
bundle_id="${stamp}-${base}-$$"
bundle="$LOG_DIR/$bundle_id"
mkdir -p "$bundle"
log="$bundle/full.log"
excerpt="$bundle/failure-excerpt.log"
manifest="$bundle/manifest.json"
start_ns="$(date +%s%N)"

set +e
"$@" >"$log" 2>&1
code=$?
set -e
end_ns="$(date +%s%N)"
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
bytes=$(wc -c <"$log" | tr -d ' ')
lines=$(wc -l <"$log" | tr -d ' ')

if [[ $code -eq 0 ]]; then
  status="PASS"
  cat >"$manifest" <<EOF
{
  "schema": "quiet-run-diagnostic-v2",
  "bundle_id": "$bundle_id",
  "status": "$status",
  "command": "$base",
  "exit_code": $code,
  "elapsed_ms": $elapsed_ms,
  "evidence": [
    {
      "id": "full-log",
      "kind": "log",
      "ref": "full.log",
      "bytes": $bytes,
      "lines": $lines,
      "priority": 9,
      "use_when": "detailed command output is explicitly needed"
    }
  ]
}
EOF
else
  status="FAIL"
  tail -n "$TAIL_LINES" "$log" >"$excerpt"
  excerpt_bytes=$(wc -c <"$excerpt" | tr -d ' ')
  excerpt_lines=$(wc -l <"$excerpt" | tr -d ' ')
  cat >"$manifest" <<EOF
{
  "schema": "quiet-run-diagnostic-v2",
  "bundle_id": "$bundle_id",
  "status": "$status",
  "command": "$base",
  "exit_code": $code,
  "elapsed_ms": $elapsed_ms,
  "evidence": [
    {
      "id": "failure-excerpt",
      "kind": "log-slice",
      "ref": "failure-excerpt.log",
      "bytes": $excerpt_bytes,
      "lines": $excerpt_lines,
      "priority": 1,
      "use_when": "the compact status is insufficient to classify the command failure"
    },
    {
      "id": "full-log",
      "kind": "log",
      "ref": "full.log",
      "bytes": $bytes,
      "lines": $lines,
      "priority": 9,
      "use_when": "the failure excerpt or targeted filtering is insufficient"
    }
  ]
}
EOF
fi

if [[ $code -eq 0 ]]; then
  printf 'PASS code=0 elapsed_ms=%s log_bytes=%s log_lines=%s manifest=%s log=%s\n' \
    "$elapsed_ms" "$bytes" "$lines" "$manifest" "$log"
else
  printf 'FAIL code=%s elapsed_ms=%s log_bytes=%s log_lines=%s manifest=%s excerpt=%s log=%s\n' \
    "$code" "$elapsed_ms" "$bytes" "$lines" "$manifest" "$excerpt" "$log"
  if [[ "$INLINE_FAILURE" == "1" ]]; then
    echo "--- requested failure excerpt: last ${TAIL_LINES} lines ---"
    cat "$excerpt"
  fi
fi
exit "$code"
